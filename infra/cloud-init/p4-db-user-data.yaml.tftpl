#cloud-config
hostname: p4-db-01
manage_etc_hosts: true

users:
  - name: ubuntu
    gecos: Ubuntu
    groups: [adm, sudo]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
disable_root: true

package_update: true

packages:
  - qemu-guest-agent
  - postgresql
  - postgresql-contrib
  - prometheus-node-exporter
  - curl

write_files:
  - path: /usr/local/sbin/phase4-db-bootstrap.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      PGCONF=/etc/postgresql/14/main/postgresql.conf
      PGHBA=/etc/postgresql/14/main/pg_hba.conf

      sed -ri \
        "s/^[#[:space:]]*listen_addresses[[:space:]]*=.*/listen_addresses = 'localhost,192.168.140.20'/" \
        "$PGCONF"

      grep -qF \
        'host phase4app phase4_app 192.168.140.10/32 scram-sha-256' \
        "$PGHBA" || \
        echo 'host phase4app phase4_app 192.168.140.10/32 scram-sha-256' \
        >> "$PGHBA"

      if runuser -u postgres -- psql -tAc \
        "SELECT 1 FROM pg_roles WHERE rolname='phase4_app'" \
        | grep -q 1; then

        runuser -u postgres -- psql \
          -c "ALTER ROLE phase4_app WITH LOGIN PASSWORD '${db_password}';"
      else
        runuser -u postgres -- psql \
          -c "CREATE ROLE phase4_app LOGIN PASSWORD '${db_password}';"
      fi

      if ! runuser -u postgres -- psql -tAc \
        "SELECT 1 FROM pg_database WHERE datname='phase4app'" \
        | grep -q 1; then

        runuser -u postgres -- createdb \
          -O phase4_app phase4app
      fi

      runuser -u postgres -- psql \
        -v ON_ERROR_STOP=1 \
        -d phase4app <<'SQL'
      SET ROLE phase4_app;

      CREATE TABLE IF NOT EXISTS support_status (
          id integer PRIMARY KEY,
          message text NOT NULL
      );

      INSERT INTO support_status (id, message)
      VALUES (1, 'database reachable')
      ON CONFLICT (id)
      DO UPDATE SET message = EXCLUDED.message;
      SQL

      systemctl restart postgresql

runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, postgresql]
  - [systemctl, enable, --now, prometheus-node-exporter]
  - [/usr/local/sbin/phase4-db-bootstrap.sh]

final_message: "p4-db-01 cloud-init complete"
