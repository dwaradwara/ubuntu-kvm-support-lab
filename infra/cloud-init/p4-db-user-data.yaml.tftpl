#cloud-config
hostname: p4-db-01
manage_etc_hosts: true

users:
  - name: ubuntu
    gecos: Ubuntu
    groups: [adm, sudo]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
disable_root: true

package_update: true

packages:
  - qemu-guest-agent
  - postgresql
  - postgresql-contrib
  - curl
  - prometheus-node-exporter

runcmd:
  - [systemctl, enable, --now, prometheus-node-exporter]
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, postgresql]

final_message: "p4-db-01 cloud-init complete"
