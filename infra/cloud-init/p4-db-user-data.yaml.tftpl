#cloud-config
hostname: p4-db-01
manage_etc_hosts: true

users:
  - name: ubuntu
    gecos: Ubuntu
    groups: [adm, sudo]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
disable_root: true

package_update: true

packages:
  - qemu-guest-agent
  - postgresql
  - postgresql-contrib
  - prometheus-node-exporter
  - curl

write_files:
  - path: /usr/local/sbin/phase4-db-bootstrap.sh
    owner: root:root
    permissions: '0750'
    encoding: b64
    content: ${bootstrap_source_b64}

  - path: /etc/phase4-db.env
    owner: root:root
    permissions: '0600'
    content: |
      PHASE4_DB_PASSWORD=${db_password}

runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, postgresql]
  - [systemctl, enable, --now, prometheus-node-exporter]
  - [/usr/local/sbin/phase4-db-bootstrap.sh]

final_message: "p4-db-01 cloud-init complete"
