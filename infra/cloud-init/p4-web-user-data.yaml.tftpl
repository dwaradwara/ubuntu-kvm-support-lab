#cloud-config
hostname: p4-web-01
manage_etc_hosts: true

groups:
  - phase4-app

users:
  - name: ubuntu
    gecos: Ubuntu
    groups: [adm, sudo]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

  - name: phase4-app
    system: true
    primary_group: phase4-app
    shell: /usr/sbin/nologin
    lock_passwd: true
    no_create_home: true

ssh_pwauth: false
disable_root: true

package_update: true

packages:
  - qemu-guest-agent
  - prometheus-node-exporter
  - python3-psycopg2
  - curl

write_files:
  - path: /opt/phase4-app/app.py
    owner: root:root
    permissions: '0750'
    encoding: b64
    content: ${app_source_b64}

  - path: /etc/phase4-app.env
    owner: root:root
    permissions: '0600'
    content: |
      PHASE4_DB_PASSWORD=${db_password}
  - path: /etc/systemd/system/phase4-app.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=Phase 4 PostgreSQL Health Application
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=phase4-app
      Group=phase4-app
      EnvironmentFile=/etc/phase4-app.env
      ExecStart=/usr/bin/python3 /opt/phase4-app/app.py
      Restart=on-failure
      RestartSec=2

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [chown, 'root:phase4-app', /opt/phase4-app/app.py]
  - [chmod, '0750', /opt/phase4-app/app.py]
  - [chown, 'root:phase4-app', /etc/phase4-app.env]
  - [chmod, '0640', /etc/phase4-app.env]
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, prometheus-node-exporter]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, phase4-app]

final_message: "p4-web-01 cloud-init complete"
